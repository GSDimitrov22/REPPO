@model List<TravelRequest>
@{ ViewData["Title"] = User.IsInRole("Admin") ? "Всички заявки" : "Моите заявки"; }
<h1>@ViewData["Title"]</h1>
@if (Model.Count == 0)
{
    <p>Все още няма заявки.</p>
    <a asp-controller="Schedules" asp-action="Index">Към разписанието</a>
}
else
{
<div class="scroll"><table><thead><tr><th>Линия</th><th>Заминаване</th>
@if (User.IsInRole("Admin")) { <th>Пътник</th> }
<th></th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr><td>@item.Schedule?.Route?.RouteName</td><td>@(item.Schedule?.DepartureTime.ToString("dd.MM.yyyy HH:mm"))</td>
    @if (User.IsInRole("Admin")) { <td>@item.User?.Email</td> }
    <td><form asp-action="Cancel" asp-route-id="@item.TravelRequestID" method="post"><button class="link">Отмени заявката</button></form></td></tr>
}
</tbody></table></div>
}
