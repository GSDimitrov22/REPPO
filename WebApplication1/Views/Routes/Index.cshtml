@model List<WebApplication1.Models.Route>
@{ ViewData["Title"] = "Маршрути"; }
<h1>Маршрути</h1>
@if (User.IsInRole("Admin"))
{
    <p><a class="button" asp-action="Create">Добави запис</a></p>
}
@if (Model.Count == 0)
{
    <p>Няма намерени записи.</p>
}
else
{
<div class="scroll"><table><thead><tr>
    <th>Линия</th>
    <th>Описание</th>
    <th>Начална спирка</th>
    <th>Крайна спирка</th>
    <th></th>
</tr></thead><tbody>
@foreach (var item in Model)
{
<tr>
    <td>@(item.RouteName)</td>
    <td>@(item.Description)</td>
    <td>@(item.StartStop?.LocationName)</td>
    <td>@(item.EndStop?.LocationName)</td>
    <td>@if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@item.RouteID">Редактирай</a>
        <form class="inline" asp-action="Delete" asp-route-id="@item.RouteID" method="post" onsubmit="return confirm('Изтриване на записа?')"><button class="link">Изтрий</button></form>
    }
    </td>
</tr>
}
</tbody></table></div>
}
