@model WebApplication1.Models.Route
@{ ViewData["Title"] = Model.RouteID == 0 ? "Нов запис" : "Редактиране"; }
<h1>@ViewData["Title"] · Маршрути</h1>
<form class="editor" asp-action="Save" asp-route-id="@Model.RouteID" method="post">
    <div asp-validation-summary="ModelOnly"></div>
    <label asp-for="RouteName"></label>
    <input asp-for="RouteName" />
    <span asp-validation-for="RouteName"></span>
    <label asp-for="Description"></label>
    <input asp-for="Description" />
    <span asp-validation-for="Description"></span>
    <label asp-for="StartStopID"></label>
    <select asp-for="StartStopID" asp-items="ViewBag.StartStopID"><option value="">Изберете…</option></select>
    <span asp-validation-for="StartStopID"></span>
    <label asp-for="EndStopID"></label>
    <select asp-for="EndStopID" asp-items="ViewBag.EndStopID"><option value="">Изберете…</option></select>
    <span asp-validation-for="EndStopID"></span>
    <div><button>Запази</button> <a asp-action="Index">Отказ</a></div>
</form>
