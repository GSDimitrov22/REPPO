<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · REPPO</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header><nav aria-label="Главно меню">
    <a class="brand" asp-controller="Home" asp-action="Index">REPPO</a>
    <a asp-controller="Schedules" asp-action="Index">Разписание</a>
    <a asp-controller="Routes" asp-action="Index">Маршрути</a>
    <a asp-controller="Stops" asp-action="Index">Спирки</a>
    <a asp-controller="Buses" asp-action="Index">Автобуси</a>
    @if (User.IsInRole("Admin"))
    {
        <a asp-controller="Drivers" asp-action="Index">Шофьори</a>
    }
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Requests" asp-action="Index">Заявки</a>
        <form asp-controller="Account" asp-action="Logout" method="post"><button class="link">Изход</button></form>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login">Вход</a>
        <a asp-controller="Account" asp-action="Register">Регистрация</a>
    }
</nav></header>
<main>
@if (TempData["Message"] is string message) { <p class="notice" role="status">@message</p> }
@RenderBody()
</main>
</body></html>
