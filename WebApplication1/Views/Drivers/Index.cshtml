@model List<WebApplication1.Models.Driver>
@{ ViewData["Title"] = "Шофьори"; }
<h1>Шофьори</h1>
@if (User.IsInRole("Admin"))
{
    <p><a class="button" asp-action="Create">Добави запис</a></p>
}
@if (Model.Count == 0)
{
    <p>Няма намерени записи.</p>
}
else
{
<div class="scroll"><table><thead><tr>
    <th>Име</th>
    <th>Фамилия</th>
    <th>Категория</th>
    <th>Дата на назначаване</th>
    <th></th>
</tr></thead><tbody>
@foreach (var item in Model)
{
<tr>
    <td>@(item.FirstName)</td>
    <td>@(item.LastName)</td>
    <td>@(item.LicenseCategory)</td>
    <td>@(item.HireDate.ToString("dd.MM.yyyy"))</td>
    <td>@if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@item.DriverID">Редактирай</a>
        <form class="inline" asp-action="Delete" asp-route-id="@item.DriverID" method="post" onsubmit="return confirm('Изтриване на записа?')"><button class="link">Изтрий</button></form>
    }
    </td>
</tr>
}
</tbody></table></div>
}
