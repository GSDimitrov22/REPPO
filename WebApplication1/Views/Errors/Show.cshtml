@model int

@{
    ViewData["Title"] = $"Грешка {Model}";
}

<h1>Грешка @Model</h1>

@if (Model == 404)
{
    <p>Страницата или записът не е намерен.</p>
}
else if (Model == 500)
{
    <p>Възникна грешка при обработката на заявката. Опитайте отново по-късно.</p>
}
else
{
    <p>Заявката не може да бъде изпълнена.</p>
}

<a asp-controller="Home" asp-action="Index">Към началната страница</a>